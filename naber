<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <title>Bir Sorum Var</title>
    <style>
        body {
            height: 100vh;
            margin: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            background: linear-gradient(135deg, #ffdde1, #ee9ca7);
            font-family: Arial, sans-serif;
        }

        .box {
            background: white;
            padding: 30px;
            border-radius: 16px;
            text-align: center;
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
        }

        h2 {
            margin-bottom: 20px;
        }

        button {
            padding: 10px 20px;
            font-size: 16px;
            border: none;
            border-radius: 10px;
            cursor: pointer;
        }

        #yesBtn {
            background-color: #4CAF50;
            color: white;
            margin-right: 20px;
        }

        #noBtn {
            background-color: #f44336;
            color: white;
            position: absolute;
        }
    </style>
</head>
<body>

<div class="box">
    <h2 id="question">Benimle çıkar mısın? 💖</h2>
    <button id="yesBtn">Evet</button>
    <button id="noBtn">Hayır</button>
</div>

<script>
    const noBtn = document.getElementById("noBtn");
    const yesBtn = document.getElementById("yesBtn");
    const question = document.getElementById("question");

    let noCount = 0;

    const noTexts = [
        "Emin misin? 🤨",
        "Bir daha düşün bence 😅",
        "Kalbim kırılıyor ama... 💔",
        "Bu kadar mı ya 😢",
        "Tamam ama son kez soruyorum 😐"
    ];

    noBtn.addEventListener("mouseover", () => {
        const x = Math.random() * (window.innerWidth - 100);
        const y = Math.random() * (window.innerHeight - 50);

        noBtn.style.left = x + "px";
        noBtn.style.top = y + "px";

        question.textContent = noTexts[noCount];
        noCount++;

        if (noCount >= noTexts.length) {
            noCount = 0;
        }
    });

    yesBtn.addEventListener("click", () => {
        question.textContent = "Biliyordum 😍 Seviliyorsun!";
        noBtn.style.display = "none";
        yesBtn.style.display = "none";
    });
</script>

</body>
</html>
